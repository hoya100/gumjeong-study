  { "text": "배우고 때때로 익히면 또한 기쁘지 아니한가.", "author": "공자", "source": "『논어』 학이편" },
  { "text": "아는 사람은 좋아하는 사람만 못하고, 좋아하는 사람은 즐기는 사람만 못하다.", "author": "공자", "source": "『논어』 옹야편" },
